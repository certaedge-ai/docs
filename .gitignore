# Only public content and required project files are tracked.
/*
!/.gitignore
!/package.json
!/package-lock.json
!/.github/
!/.vitepress/
!/content/
!/scripts/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

/.vitepress/*
!/.vitepress/config.mts
!/.vitepress/navigation.json
!/.vitepress/search-tokenizer.mjs
!/.vitepress/site-links.mjs
!/.vitepress/theme/
/.vitepress/theme/*
!/.vitepress/theme/*.vue
!/.vitepress/theme/*.ts
!/.vitepress/theme/*.css

/scripts/*
!/scripts/check-build.mjs
!/scripts/check-content.mjs

/content/**
!/content/**/
!/content/首页.md
!/content/入门/*.md
!/content/工具/*.md
!/content/生成任务/*.md
!/content/en/首页.md
!/content/en/入门/*.md
!/content/en/工具/*.md
!/content/en/生成任务/*.md
!/content/public/CNAME
!/content/public/certaedge-mark.svg
!/content/public/images/**/*.svg
!/content/public/images/**/*.png
